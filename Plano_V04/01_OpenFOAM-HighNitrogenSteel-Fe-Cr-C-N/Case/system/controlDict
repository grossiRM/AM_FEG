FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     X30Cr15N_Sh;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.0024;

deltaT          1e-8;

writeControl    adjustableRunTime;

writeInterval   0.00002;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable no;

adjustTimeStep  yes;

maxCo           0.7;
maxAlphaCo      0.7;

maxDeltaT       5e-7;

OptimisationSwitches
{
    fileHandler collated;
}
