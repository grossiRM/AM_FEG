FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.*"
    {
        nAlphaCorr      1;
        nAlphaSubCycles 2;
        cAlpha          1;

        solver          smoothSolver;
        smoother        GaussSeidel;
        tolerance       1e-10;    //1e-08
        relTol          0;
        nSweeps         1;
    }

    "pcorr.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-7;   //1e-10
        relTol          0;    
    }

    p_rgh
    {
     /*   solver          PCG;
        preconditioner  DIC;
        tolerance       1e-5;   //1e-8
        relTol          0.05;  */
        
        solver                GAMG;
        tolerance             1e-6;   //1e-8
        relTol                0.01;
        smoother              GaussSeidel;
        nPreSweeps            0;
        nPostSweeps           2;
        cacheAgglomeration    on;
        agglomerator          faceAreaPair;
        nCellsInCoarsestLevel 1000;
        mergeLevels           1;        
        
    }

    p_rghFinal
    {
     /*   solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;   //1e-8
        relTol          0.05;  */          
        
        solver                GAMG;
        tolerance             1e-6;   //1e-8
        relTol                0.0;
        smoother              GaussSeidel;
        nPreSweeps            0;
        nPostSweeps           2;
        cacheAgglomeration    on;
        agglomerator          faceAreaPair;
        nCellsInCoarsestLevel 1000;
        mergeLevels           1;    
        

    }

    U
    {
     /*   solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;   //1e-8
        relTol          0;      */
        
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-6;   //1e-8
        relTol          0;                     
        
    }
    
    T 
    {
      /*
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-07;
        relTol          0.05;   
        */       
        
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-12;                // don't rush the solutions, keep high tolerances as possible to converse better          
        relTol          0;        
    }
    
    TFinal
    {
        $T;
        relTol          0;
    }
    
    Y
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
    }
    
    YFinal
    {
        $Y;
        relTol          0;
    }

    PhiYFinal
	{
	solver PCG;
	preconditioner
	{
	preconditioner GAMG;
	tolerance 1e-9;
	relTol 0;
	smoother DICGaussSeidel;
	}
	tolerance 1e-9;
	relTol 0;
	maxIter 100;
	}
    

/*
    Y
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-12;
        relTol          0;
    }

    YFinal
    {
        $Y;
        relTol          0;
    }

    PhiYFinal
    {
        solver          GAMG;
        smoother  	DIC;
        tolerance       1e-12;
        relTol          0;
    }
*/
}

PIMPLE
{
    momentumPredictor   no;
    nOuterCorrectors    1;
    nCorrectors         3;
    nNonOrthogonalCorrectors 0;
}

relaxationFactors
{
    equations
    {
        ".*" 1;
    }
}


