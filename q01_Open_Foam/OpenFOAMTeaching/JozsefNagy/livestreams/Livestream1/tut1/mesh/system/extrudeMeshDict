FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

constructFrom   surface;

surface         "tut1.obj";

flipNormals     false;

extrudeModel    linearNormal;

nLayers         1;

expansionRatio  1.0;

thickness        0.001;

mergeFaces false;

mergeTol 0;

